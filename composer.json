{
    "name": "magdicom/hooks",
    "description": "A lightweight, framework-independent PHP hooks package with actions, filters, collectors, processors, and renderers.",
    "keywords": [
        "actions",
        "collectors",
        "extensibility",
        "filters",
        "hooks",
        "magdicom",
        "php",
        "renderers"
    ],
    "homepage": "https://github.com/magdicom/hooks",
    "support": {
        "issues": "https://github.com/magdicom/hooks/issues",
        "source": "https://github.com/magdicom/hooks"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "magdicom",
            "email": "m@momagdi.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Magdicom\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Magdicom\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true
}
